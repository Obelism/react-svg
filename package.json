{
	"name": "@obelism/react-svg",
	"description": "A performant way to load and show SVG in React applications",
	"keywords": [
		"svg",
		"react",
		"icons",
		"request",
		"cache"
	],
	"license": "MIT",
	"version": "3.0.1",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/react-svg"
	},
	"main": "./dist/index.cjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bunchee -w",
		"build": "bunchee --minify --sourcemap=false",
		"test": "vitest",
		"test:ci": "vitest run",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"format": "biome format --write"
	},
	"peerDependencies": {
		"react": ">=17.0.0",
		"swr": ">=2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@typescript/typescript6": "^6.0.2",
		"@vitejs/plugin-react": "^6.1.2",
		"bunchee": "^6.12.2",
		"jsdom": "^30.1.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"ts-node": "^10.9.1",
		"tslib": "^2.6.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
